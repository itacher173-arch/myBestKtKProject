# Тестовый профиль окружения (локальная разработка / демо)
# Пароли намеренно простые — не использовать в продакшене.
#
# Запуск:
#   docker compose --env-file .env.test up --build -d
# или:
#   cp .env.test .env && docker compose up --build -d

COMPOSE_PROJECT_NAME=myktkprodject

POSTGRES_USER=ktk
POSTGRES_PASSWORD=admin
POSTGRES_DB=ktk
DATABASE_URL=postgresql://ktk:admin@postgres:5432/ktk
REDIS_URL=redis://redis:6379/0

VITE_APP_URL=/app/
VITE_AUTH_URL=/

KTK_CORS_ORIGINS=http://localhost:8080

# Три фиксированные demo-записи. При каждом старте auth-сервиса их роли и
# пароли восстанавливаются до указанных значений.
KTK_DEMO_ACCOUNTS_ENABLED=true
KTK_ADMIN_LOGIN=admin
KTK_ADMIN_NAME=Демо-администратор
KTK_ADMIN_PASSWORD=admin
KTK_DEMO_INSTRUCTOR_LOGIN=instructor
KTK_DEMO_INSTRUCTOR_NAME=Демо-инструктор
KTK_DEMO_INSTRUCTOR_PASSWORD=instructor
KTK_DEMO_TRAINEE_LOGIN=trainee
KTK_DEMO_TRAINEE_NAME=Демо-обучаемый
KTK_DEMO_TRAINEE_PASSWORD=trainee

# Секрет цепочки аудита (тестовый; не менять после появления записей в audit_log)
KTK_AUDIT_HMAC_SECRET=ktk-test-audit-hmac-local-dev-only

KTK_FASTAPI_PORT=8010
KTK_SIM_TICK_SEC=0.25

KTK_AI_ENABLED=true
KTK_AI_PROVIDER=auto
KTK_LLM_MODEL=qwen2.5-1.5b-instruct
KTK_LLM_MODEL_FILE=Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
KTK_LLM_MODEL_URL=https://github.com/itacher173-arch/myBestKtKProject/releases/download/ai-model-qwen2.5-1.5b-v1/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
KTK_LLM_MODEL_SHA256=1adf0b11065d8ad2e8123ea110d1ec956dab4ab038eab665614adba04b6c3370
KTK_RAG_EMBEDDING_PROVIDER=hash
KTK_RAG_COLLECTION=ktk_knowledge
KTK_KNOWLEDGE_INDEX_VERSION=knowledge-v3
KTK_AI_PROMPT_VERSION=ai-prompts-v2
