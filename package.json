{
  "name": "myktkprodject",
  "private": true,
  "version": "0.1.0",
  "description": "myKTKProdject — КТК ЭЛОУ-АВТ (auth + trainer + admin + backend)",
  "scripts": {
    "dev": "npm --prefix frontend/trainer run dev",
    "build": "npm --prefix frontend/trainer run build",
    "preview": "npm --prefix frontend/trainer run preview",
    "backend": "python3 -m backend.run_all",
    "dev:api": "python3 -m backend.run_all",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down --remove-orphans",
    "docker:logs": "docker compose logs -f",
    "build:web": "docker compose build web",
    "build:admin": "npm --prefix frontend/admin run build",
    "dev:admin": "npm --prefix frontend/admin run dev",
    "build:auth": "npm --prefix frontend/auth run build",
    "dev:auth": "npm --prefix frontend/auth run dev"
  }
}
