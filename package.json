{
  "name": "ktk-elou-avt",
  "private": true,
  "version": "0.1.0",
  "description": "КТК ЭЛОУ-АВТ — монорепозиторий frontend + backend",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "backend": "python3 -m backend.run_all",
    "dev:api": "python3 -m backend.run_all",
    "electron": "npm --prefix frontend run electron",
    "dist": "npm --prefix frontend run dist",
    "dist:win": "npm --prefix frontend run dist:win",
    "dist:mac": "npm --prefix frontend run dist:mac",
    "docker:up": "npm --prefix frontend run build && docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  }
}
