{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktk.local/schemas/knowledge-article.json",
  "title": "KTK ELOU-AVT knowledge article",
  "type": "object",
  "required": ["id", "title", "category", "summary", "keywords", "sections"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 8},
    "category": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 30},
    "keywords": {"type": "array", "minItems": 3, "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["draft", "requires-expert-review", "expert-reviewed", "approved-for-training"]},
    "roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string"},
          "paragraphs": {"type": "array", "items": {"type": "string"}},
          "bullets": {"type": "array", "items": {"type": "string"}},
          "warning": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "publisher", "kind"],
        "properties": {"url": {"type": "string", "format": "uri"}}
      }
    }
  }
}
