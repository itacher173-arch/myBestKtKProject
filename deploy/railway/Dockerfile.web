# Один публичный UI: auth (/) + КТК (/app/) + admin (/admin/)
FROM node:22-alpine AS build

WORKDIR /src
COPY auth-frontend/package.json auth-frontend/package-lock.json ./auth-frontend/
COPY frontend/package.json frontend/package-lock.json ./frontend/
COPY admin-frontend/package.json admin-frontend/package-lock.json ./admin-frontend/

RUN npm ci --prefix auth-frontend \
 && npm ci --prefix frontend \
 && npm ci --prefix admin-frontend

COPY auth-frontend ./auth-frontend
COPY frontend ./frontend
COPY admin-frontend ./admin-frontend

ARG VITE_APP_URL=/app/
ARG VITE_AUTH_URL=/
ENV VITE_APP_URL=$VITE_APP_URL \
    VITE_AUTH_URL=$VITE_AUTH_URL

RUN npm --prefix auth-frontend run build \
 && npm --prefix frontend run build -- --base /app/ \
 && npm --prefix admin-frontend run build -- --base /admin/

FROM nginx:1.27-alpine

RUN apk add --no-cache gettext \
 && rm -f /etc/nginx/conf.d/default.conf

COPY deploy/railway/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/railway/docker-entrypoint-web.sh /docker-entrypoint-web.sh
RUN chmod +x /docker-entrypoint-web.sh

COPY --from=build /src/auth-frontend/dist /usr/share/nginx/html
COPY --from=build /src/frontend/dist /usr/share/nginx/html/app
COPY --from=build /src/admin-frontend/dist /usr/share/nginx/html/admin

ENV PORT=8080 \
    API_HOST=system-api \
    GATEWAY_PORT=8000 \
    FASTAPI_PORT=8010 \
    PRESENCE_PORT=8106 \
    AUTH_REDIRECT_PATH=/ \
    DNS_RESOLVER=127.0.0.11

EXPOSE 8080
CMD ["/docker-entrypoint-web.sh"]
