# Единый UI: auth (/) + КТК (/app/) + admin (/admin/)
# Dist собирается на хосте (см. npm run docker:up / scripts/build-web.sh)
FROM nginx:1.27-alpine

RUN apk add --no-cache gettext \
 && rm -f /etc/nginx/conf.d/default.conf

COPY deploy/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/docker/docker-entrypoint-web.sh /docker-entrypoint-web.sh
RUN chmod +x /docker-entrypoint-web.sh

COPY auth-frontend/dist /usr/share/nginx/html
COPY frontend/dist /usr/share/nginx/html/app
COPY admin-frontend/dist /usr/share/nginx/html/admin

ENV PORT=8080 \
    API_HOST=system-api \
    GATEWAY_PORT=8000 \
    FASTAPI_PORT=8010 \
    PRESENCE_PORT=8106 \
    AUTH_REDIRECT_PATH=/ \
    DNS_RESOLVER=127.0.0.11

EXPOSE 8080
CMD ["/docker-entrypoint-web.sh"]
