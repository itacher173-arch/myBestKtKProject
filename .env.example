# Docker Compose (локальная разработка / демо)
COMPOSE_PROJECT_NAME=myktkprodject

# Postgres / Redis — только внутри docker-сети (порты наружу не публикуются)
POSTGRES_USER=ktk
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ktk
DATABASE_URL=postgresql://ktk:change-me-postgres@postgres:5432/ktk
REDIS_URL=redis://redis:6379/0

# Единый web в Docker: / → вход, /app/ → КТК, /admin/ → админка
VITE_APP_URL=/app/
VITE_AUTH_URL=/

# CORS
# KTK_CORS_ORIGINS=http://localhost:8080

# Bootstrap-админ создаётся только если админов ещё нет.
KTK_ADMIN_LOGIN=
KTK_ADMIN_NAME=
KTK_ADMIN_PASSWORD=

# Обязателен для Docker Compose (без значения compose не стартует)
KTK_AUDIT_HMAC_SECRET=change-me-audit-hmac

# KTK_COOKIE_SECURE=1

KTK_FASTAPI_PORT=8010
KTK_SIM_TICK_SEC=0.25

# AI orchestration:
# rules — ML + RAG без генеративной LLM;
# auto — использовать локальный llama.cpp, если профиль llm запущен, иначе fallback.
KTK_AI_ENABLED=true
KTK_AI_PROVIDER=auto
KTK_LLM_MODEL=qwen2.5-1.5b-instruct
KTK_LLM_MODEL_FILE=Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
KTK_LLM_MODEL_URL=https://github.com/itacher173-arch/myBestKtKProject/releases/download/ai-model-qwen2.5-1.5b-v1/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
KTK_LLM_MODEL_SHA256=1adf0b11065d8ad2e8123ea110d1ec956dab4ab038eab665614adba04b6c3370
KTK_RAG_EMBEDDING_PROVIDER=hash
KTK_RAG_COLLECTION=ktk_knowledge
KTK_KNOWLEDGE_INDEX_VERSION=knowledge-v3
KTK_AI_PROMPT_VERSION=ai-prompts-v2

# Только для локального python без Docker:
# KTK_ALLOW_INSECURE_DEFAULTS=1
