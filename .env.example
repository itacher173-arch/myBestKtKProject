# Docker Compose (локальная разработка / демо)
COMPOSE_PROJECT_NAME=myktkprodject

# Postgres / Redis — только внутри docker-сети (порты наружу не публикуются)
POSTGRES_USER=ktk
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ktk
DATABASE_URL=postgresql://ktk:change-me-postgres@postgres:5432/ktk
REDIS_URL=redis://redis:6379/0

# Единый web в Docker: / → вход, /app/ → КТК, /admin/ → админка
VITE_APP_URL=/app/
VITE_AUTH_URL=/

# CORS
# KTK_CORS_ORIGINS=http://localhost:8080

# Bootstrap-админ создаётся только если админов ещё нет.
KTK_ADMIN_LOGIN=
KTK_ADMIN_NAME=
KTK_ADMIN_PASSWORD=

# Обязателен для Docker Compose (без значения compose не стартует)
KTK_AUDIT_HMAC_SECRET=change-me-audit-hmac

# KTK_COOKIE_SECURE=1

KTK_FASTAPI_PORT=8010
KTK_SIM_TICK_SEC=0.25

# AI orchestration:
# rules — ML + RAG без генеративной LLM;
# auto — использовать Ollama, если профиль llm запущен, иначе fallback.
KTK_AI_ENABLED=true
KTK_AI_PROVIDER=rules
KTK_OLLAMA_BASE_MODEL=qwen2.5:3b
KTK_OLLAMA_MODEL=ktk-assistant
KTK_OLLAMA_EMBED_MODEL=nomic-embed-text
KTK_RAG_EMBEDDING_PROVIDER=auto
KTK_RAG_COLLECTION=ktk_knowledge
KTK_KNOWLEDGE_INDEX_VERSION=knowledge-v1
KTK_AI_PROMPT_VERSION=ai-prompts-v1

# Только для локального python без Docker:
# KTK_ALLOW_INSECURE_DEFAULTS=1
