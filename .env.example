# Docker Compose (локальная разработка / демо)
COMPOSE_PROJECT_NAME=myKTKProdject

# Postgres / Redis — только внутри docker-сети (порты наружу не публикуются)
POSTGRES_USER=ktk
POSTGRES_PASSWORD=ktk
POSTGRES_DB=ktk
DATABASE_URL=postgresql://ktk:ktk@postgres:5432/ktk
REDIS_URL=redis://redis:6379/0

# Публичные URL UI (локальный Vite / единый web в Docker)
# Docker web: / → вход, /app/ → КТК, /admin/ → админка
VITE_APP_URL=/app/
VITE_AUTH_URL=/

# CORS (через запятую). Пустое = дефолтные localhost UI-порты
# KTK_CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082

# Bootstrap-админ создаётся только если админов ещё нет.
# Значения задайте в незакоммиченном .env или через менеджер секретов.
KTK_ADMIN_LOGIN=
KTK_ADMIN_NAME=
KTK_ADMIN_PASSWORD=

# HMAC-секрет цепочки аудита (в проде задайте уникальный)
KTK_AUDIT_HMAC_SECRET=ktk-dev-audit-secret-change-me

# Secure-cookie для HTTPS (Railway / прод). Локально не нужно.
# KTK_COOKIE_SECURE=1

# FastAPI (серверный такт / валидация сценариев / metrics)
KTK_FASTAPI_PORT=8010
KTK_SIM_TICK_SEC=0.25

# --- Railway (см. deploy/railway/README.md) ---
# Публичный UI: один сервис web → /  /app/  /admin/
# API: auth-api + system-api; БД: Postgres + Redis (managed)
