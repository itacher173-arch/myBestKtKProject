# Docker Compose (локальная разработка / демо)
COMPOSE_PROJECT_NAME=myKTKProdject

# Postgres
POSTGRES_USER=ktk
POSTGRES_PASSWORD=ktk
POSTGRES_DB=ktk
DATABASE_URL=postgresql://ktk:ktk@postgres:5432/ktk

# Redis (presence + rate-limit + сессии)
REDIS_URL=redis://redis:6379/0

# Публичные URL UI
# AUTH :8082 → после входа редирект на APP :8080
VITE_APP_URL=http://localhost:8080
VITE_AUTH_URL=http://localhost:8082

# Bootstrap-админ (вход по логину)
KTK_ADMIN_LOGIN=admin
KTK_ADMIN_NAME=Администратор
KTK_ADMIN_PASSWORD=admin
